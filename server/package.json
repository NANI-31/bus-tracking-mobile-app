{
  "name": "college-bus-tracking-server",
  "version": "1.0.0",
  "description": "Server for College Bus Tracking App",
  "main": "dist/index.js",
  "scripts": {
    "start": "node dist/index.js",
    "dev": "nodemon",
    "seed": "ts-node -r tsconfig-paths/register src/seed.ts",
    "seed-plans": "ts-node -r tsconfig-paths/register src/scripts/seed_plans.ts",
    "build": "tsc && tsc-alias",
    "test": "jest --coverage",
    "test:watch": "jest --watch",
    "test:load:gen": "ts-node -r tsconfig-paths/register tests/load/gen-tokens.ts",
    "test:load:custom": "ts-node -r tsconfig-paths/register tests/load/load-tester.ts",
    "test:load:run": "artillery run tests/load/socket-load.yml"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.995.0",
    "@aws-sdk/lib-storage": "^3.995.0",
    "@aws-sdk/s3-request-presigner": "^3.995.0",
    "@socket.io/redis-adapter": "^8.3.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/exceljs": "^0.5.3",
    "@types/express": "^4.17.21",
    "@types/express-mongo-sanitize": "^1.3.2",
    "@types/hpp": "^0.2.7",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.97",
    "@types/multer": "^2.0.0",
    "@types/node": "^20.10.4",
    "@types/node-cron": "^3.0.11",
    "@types/nodemailer": "^7.0.4",
    "@types/socket.io": "^3.0.1",
    "@types/uuid": "^10.0.0",
    "bcryptjs": "^3.0.3",
    "config": "^4.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "exceljs": "^4.4.0",
    "express": "^4.18.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^8.2.1",
    "firebase-admin": "^10.3.0",
    "googleapis": "^169.0.0",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "lru-cache": "^11.2.4",
    "mongoose": "^9.3.0",
    "multer": "^2.0.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^7.0.12",
    "nodemon": "^3.1.11",
    "rate-limiter-flexible": "^9.0.1",
    "razorpay": "^2.9.6",
    "redis": "^5.10.0",
    "socket.io": "^4.8.3",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "uuid": "^13.0.0",
    "winston": "^3.19.0",
    "xss": "^1.0.15",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/supertest": "^7.2.0",
    "artillery": "^2.0.30",
    "jest": "^29.7.0",
    "jest-mock-extended": "^4.0.0",
    "mongodb-memory-server": "^11.0.1",
    "redis-mock": "^0.56.3",
    "snyk": "^1.1303.1",
    "socket.io-client": "^4.8.3",
